{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "admin:create": "tsx scripts/create-admin.ts",
    "seed:matching": "node --import tsx scripts/seed-matching-demo.cjs",
    "data:fetch": "python3 scripts/fetch-transfermarkt.py",
    "data:prepare": "python3 scripts/prepare-transfermarkt.py",
    "data:scope:top5": "node --import tsx scripts/restrict-to-top5.cjs",
    "data:import": "node --import tsx scripts/import-transfermarkt.cjs",
    "data:positions": "node --import tsx scripts/normalize-player-positions.cjs",
    "data:stats:prepare": "python3 scripts/prepare-supplemental-stats.py",
    "data:stats:import": "node --import tsx scripts/import-supplemental-stats.cjs",
    "data:enrich:fetch": "python3 scripts/fetch-footballtoday-stats.py",
    "data:enrich:identities": "node --import tsx scripts/snapshot-stat-coverage.cjs && python3 scripts/find-footballtoday-identities.py && python3 scripts/fetch-footballtoday-identities.py",
    "data:enrich:prepare": "python3 scripts/prepare-stats-enrichment.py",
    "data:enrich:import": "node --import tsx scripts/import-stats-enrichment.cjs",
    "test:data-enrich": "python3 tests/stats-enrichment-prepare.test.py && node tests/stats-enrichment-plan.test.cjs",
    "test:data-enrich-import": "node --import tsx tests/stats-enrichment-import.test.cjs",
    "test:data-stats": "python3 tests/supplemental-stats-prepare.test.py && node tests/supplemental-stats-plan.test.cjs",
    "test:data-stats-import": "node --import tsx tests/supplemental-stats-import.test.cjs",
    "test:data-prepare": "python3 tests/transfermarkt-prepare.test.py",
    "test:top5-scope": "node --import tsx tests/top5-scope.test.cjs",
    "test:data-import": "node --import tsx tests/transfermarkt-import.test.cjs",
    "test:matching-demo": "node --import tsx tests/matching-demo.test.cjs",
    "test:access": "tsx tests/access.test.cjs",
    "test:entities": "tsx tests/domain-entities.test.cjs",
    "test:extended": "tsx tests/extended-api.test.cjs",
    "test:matching-data": "tsx tests/matching-data.test.cjs",
    "test:matching-api": "tsx tests/matching-api.test.cjs",
    "test:financial": "node --import tsx tests/financial-scoring.test.cjs",
    "test:financial-api": "tsx tests/financial-api.test.cjs",
    "test:matching": "node --import tsx tests/matching-scoring.test.cjs",
    "test:squad-preview": "node --import tsx tests/squad-preview-api.test.cjs",
    "test:risk-preview": "node --import tsx tests/risk-preview-api.test.cjs",
    "test:matching-engine-api": "tsx tests/matching-engine-api.test.cjs",
    "test:login": "tsx tests/login-page.test.cjs",
    "data:repair": "node --import tsx scripts/repair-football-data.cjs",
    "data:estimate": "node --import tsx scripts/estimate-missing-stats.cjs",
    "test:estimation": "node tests/stat-estimation.test.cjs",
    "test:estimation-api": "tsx tests/stat-estimate-api.test.cjs",
    "data:estimate:prepare": "python3 scripts/prepare-personal-stat-evidence.py",
    "data:metrics:fetch": "python3 scripts/fetch-v3-metric-sources.py",
    "data:metrics": "node --import tsx scripts/import-v3-metrics.cjs",
    "test:metrics": "python3 tests/v3-metrics.test.py",
    "matching:v3:prepare": "node --import tsx scripts/prepare-matching-v3.cjs",
    "test:matching-v3": "node --import tsx --test tests/matching-v3-inputs.test.cjs",
    "test:matching-v3-inputs-api": "node --import tsx tests/matching-v3-inputs-api.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
